# Example environment configuration for CLIProxyAPI.
# Copy this file to `.env` and fill in the values you need.
#
# NOTE: For the plain proxy with local file storage (default), you need NOTHING
# here. The variables below are only for optional features / remote storage.

# ==============================================================================
# Billing / commercial portal (privileged accounts, wallets, API keys, ...)
# ------------------------------------------------------------------------------
# docker-compose.yml runs its OWN postgres container, so you do NOT need to
# install or configure a database. For that setup you only need the TWO values
# below; everything else (the database user/password/DSN) is pre-wired and
# matches automatically. Then run:  docker compose up -d --build
# ==============================================================================

# REQUIRED — a long random secret used to sign portal login tokens.
# Generate one with:  openssl rand -hex 32
BILLING_JWT_SECRET=

# REQUIRED — your email. Register with it in the portal (/portal/ui/), then
# restart the container and you become the admin.
BILLING_ADMIN_EMAIL=

# Billing gets its OWN database via BILLING_DATABASE_URL. This is separate from
# PGSTORE_DSN below: it only creates the billing tables and does NOT take over
# auth/config storage, so your file-based auths (auths/) and config.yaml keep
# working exactly as before. docker-compose.yml wires this to the bundled
# postgres container automatically.
#
# OPTIONAL — the built-in database password. The DB is not exposed outside
# Docker, so the default is fine for a private server. If you DO change it,
# uncomment BOTH lines and keep the two passwords identical.
# POSTGRES_PASSWORD=change-me
# BILLING_DATABASE_URL=postgres://cpa:change-me@postgres:5432/cpa?sslmode=disable

# OPTIONAL — pricing / limits
# BILLING_MARKUP=1.2                       # charge 20% over upstream cost
# BILLING_BALANCE_THRESHOLD=0              # reject when balance <= this
# BILLING_UNBILLED_BYPASS_RATE_LIMIT=false # also exempt unbilled keys from rate limit

# OPTIONAL — passwordless email-code login. Set BILLING_SMTP_HOST to enable
# (the portal shows the "验证码" login tab only when it is configured). Any SMTP
# works — e.g. Gmail with an App Password. Cloudflare has no outbound SMTP.
# BILLING_SMTP_HOST=smtp.gmail.com
# BILLING_SMTP_PORT=587                    # 587 STARTTLS (default) / 465 implicit TLS
# BILLING_SMTP_USERNAME=you@gmail.com
# BILLING_SMTP_PASSWORD=your-app-password
# BILLING_SMTP_FROM=you@gmail.com          # defaults to USERNAME
# BILLING_LOGIN_CODE_TTL=10m
# BILLING_LOGIN_CODE_COOLDOWN=60s

# Which image to run. For the "pull from Docker Hub" flow, replace
# YOUR_DOCKERHUB_USERNAME with yours (the CI publishes this tag). If you'd
# rather build from source instead, ignore this and run:
#   docker compose up -d --build
CLI_PROXY_IMAGE=YOUR_DOCKERHUB_USERNAME/cli-proxy-api:claude-request-logs-billing

# ------------------------------------------------------------------------------
# Management Web UI
# ------------------------------------------------------------------------------
# MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------------------------
# Postgres Token Store (optional)
# ------------------------------------------------------------------------------
# PGSTORE_DSN=postgresql://user:pass@localhost:5432/cliproxy
# PGSTORE_SCHEMA=public
# PGSTORE_LOCAL_PATH=/var/lib/cliproxy

# ------------------------------------------------------------------------------
# Git-Backed Config Store (optional)
# ------------------------------------------------------------------------------
# GITSTORE_GIT_URL=https://github.com/your-org/cli-proxy-config.git
# GITSTORE_GIT_USERNAME=git-user
# GITSTORE_GIT_TOKEN=ghp_your_personal_access_token
# GITSTORE_LOCAL_PATH=/data/cliproxy/gitstore

# ------------------------------------------------------------------------------
# Object Store Token Store (optional)
# ------------------------------------------------------------------------------
# OBJECTSTORE_ENDPOINT=https://s3.your-cloud.example.com
# OBJECTSTORE_BUCKET=cli-proxy-config
# OBJECTSTORE_ACCESS_KEY=your_access_key
# OBJECTSTORE_SECRET_KEY=your_secret_key
# OBJECTSTORE_LOCAL_PATH=/data/cliproxy/objectstore
